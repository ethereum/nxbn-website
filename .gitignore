# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# Generated by next-sitemap's postbuild straight into the export output (out/).
# They used to be committed under public/, which produced a spurious `lastmod`
# diff on every build.
sitemap.xml
sitemap-0.xml
robots.txt

# Scratch output from the Playwright MCP browser tooling.
.playwright-mcp/
